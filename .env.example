# Copia este archivo a apps/web/.env.local y llena los valores. NUNCA subas valores reales.

# Supabase (proyecto nuevo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (rutas API y scripts locales). Nunca en el navegador ni en firmware.
SUPABASE_SERVICE_ROLE_KEY=

# Simulador (tools/simulator). `npm run provision` genera y escribe estos valores.
INGEST_URL=http://localhost:3000/api/ingest
TOY_DEVICE_TOKEN=
TOY2_DEVICE_TOKEN=
BOX_DEVICE_TOKEN=
DEMO_PASSWORD=

# Modo demo (página /demo: el teléfono hace de juguete y caja). APAGAR (quitar) en producción real.
DEMO_MODE=
